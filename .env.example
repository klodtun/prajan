PORT=3000
BASE_PATH=/prajan
PUBLIC_BASE_URL=https://sgc.co.th/prajan

# LINE Developers > Messaging API
LINE_CHANNEL_SECRET=replace_with_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_with_long_lived_access_token

# Optional: voice message transcription.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prajan
DB_PASSWORD=replace_with_password
DB_NAME=prajan

# Simple admin gate for /admin API calls.
ADMIN_TOKEN=change_this_admin_token
